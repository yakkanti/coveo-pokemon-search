# Leave these unset to run against Coveo's public sample org.
# Use a search-only API key (Search: Execute queries, Analytics: Push). It is exposed to the browser.
NEXT_PUBLIC_COVEO_ORG_ID=
NEXT_PUBLIC_COVEO_API_KEY=
NEXT_PUBLIC_COVEO_SEARCH_HUB=PokemonSearch

# "Ask about this Pokémon" (detail pages). Server-only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
# Without it the Ask box shows "Ask isn't configured on this deployment yet."
ANTHROPIC_API_KEY=
